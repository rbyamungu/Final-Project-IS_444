<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Prototype_Final_Project.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Prototype_Final_Project.Views"
    Title="App Wishlist">

    <TabBar>
        <ShellContent
            Title="Trending"
            ContentTemplate="{DataTemplate views:DiscoveryFeedPage}"
            Route="DiscoveryFeedPage" />

        <ShellContent
            Title="New Wish"
            ContentTemplate="{DataTemplate views:SubmitWishPage}"
            Route="SubmitWishPage" />

        <ShellContent
            Title="Developer Hub"
            ContentTemplate="{DataTemplate views:DeveloperDashboardPage}"
            Route="DeveloperDashboardPage" />

        <ShellContent
            Title="About"
            ContentTemplate="{DataTemplate views:AboutProjectPage}"
            Route="AboutProjectPage" />
    </TabBar>

</Shell>
