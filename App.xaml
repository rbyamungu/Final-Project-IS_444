<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:Prototype_Final_Project.Converters"
             x:Class="Prototype_Final_Project.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Global Converters -->
            <converters:StatusColorConverter x:Key="StatusColorConverter" />
            <converters:StatusDisplayNameConverter x:Key="StatusDisplayNameConverter" />
            <converters:SubmissionTypeBadgeConverter x:Key="SubmissionTypeBadgeConverter" />
            <converters:IsNotEmptyConverter x:Key="IsNotEmptyConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />

            <!-- Brand Design Tokens -->
            <Color x:Key="PrimaryBrandColor">#2563EB</Color>
            <Color x:Key="SecondaryBrandColor">#1E40AF</Color>
            <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
            <Color x:Key="BorderLightColor">#E2E8F0</Color>
            <Color x:Key="TextPrimaryColor">#0F172A</Color>
            <Color x:Key="TextMutedColor">#64748B</Color>
            <Color x:Key="BackgroundPageColor">#F8FAFC</Color>

            <!-- Card Border Style -->
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Stroke" Value="{StaticResource BorderLightColor}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="BackgroundColor" Value="{StaticResource CardBackgroundColor}" />
                <Setter Property="StrokeShape" Value="RoundRectangle 8" />
            </Style>

            <!-- Filter Button Style -->
            <Style x:Key="FilterButtonStyle" TargetType="Button">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="HeightRequest" Value="34" />
                <Setter Property="CornerRadius" Value="17" />
                <Setter Property="BackgroundColor" Value="#F1F5F9" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimaryColor}" />
                <Setter Property="Padding" Value="14,0" />
            </Style>

            <!-- Primary Action Button Style -->
            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryBrandColor}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
