<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Prototype_Final_Project.ViewModels"
             xmlns:models="clr-namespace:Prototype_Final_Project.Models"
             x:Class="Prototype_Final_Project.Views.DeveloperDashboardPage"
             x:DataType="viewmodels:DeveloperDashboardViewModel"
             Title="Developer Hub"
             BackgroundColor="#F8FAFC">

    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
        <ScrollView>
            <VerticalStackLayout Spacing="16" Padding="14">

                <!-- Hub Header Banner -->
                <Border BackgroundColor="#0F172A" Padding="16" StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="🛠️ Developer Discovery &amp; Claim Hub" FontSize="18" FontAttributes="Bold" TextColor="White" />
                        <Label Text="Eliminate product-market risk. Browse high-velocity mobile app concepts verified by real users before writing code." 
                               FontSize="12" TextColor="#94A3B8" />
                    </VerticalStackLayout>
                </Border>

                <!-- Statistics Metrics Row -->
                <Grid ColumnDefinitions="*, *, *" ColumnSpacing="8">
                    <Border Grid.Column="0" BackgroundColor="White" Padding="10" Style="{StaticResource CardBorderStyle}">
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                            <Label Text="{Binding OpenCount}" FontSize="20" FontAttributes="Bold" TextColor="#2563EB" HorizontalOptions="Center" />
                            <Label Text="Open Ideas" FontSize="11" TextColor="#64748B" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1" BackgroundColor="White" Padding="10" Style="{StaticResource CardBorderStyle}">
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                            <Label Text="{Binding ClaimedCount}" FontSize="20" FontAttributes="Bold" TextColor="#D97706" HorizontalOptions="Center" />
                            <Label Text="In Progress" FontSize="11" TextColor="#64748B" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="2" BackgroundColor="White" Padding="10" Style="{StaticResource CardBorderStyle}">
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                            <Label Text="{Binding ShippedCount}" FontSize="20" FontAttributes="Bold" TextColor="#16A34A" HorizontalOptions="Center" />
                            <Label Text="Shipped" FontSize="11" TextColor="#64748B" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Section: Open Opportunities -->
                <Label Text="💡 High-Demand Opportunities Needing Builders" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextPrimaryColor}" Margin="0,6,0,0" />

                <CollectionView ItemsSource="{Binding OpenIdeas}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:WishItem">
                            <Border Margin="0,4" Padding="12" Style="{StaticResource CardBorderStyle}">
                                <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="*, Auto">
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                        <Label Text="{Binding Title}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextPrimaryColor}" />
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="{Binding UpvoteCount, StringFormat='🔥 {0} upvotes'}" FontSize="11" TextColor="#2563EB" FontAttributes="Bold" />
                                            <Label Text="•" FontSize="11" TextColor="Gray" />
                                            <Label Text="{Binding TargetPlatform}" FontSize="11" TextColor="#64748B" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>

                                    <Button Grid.Row="0" Grid.Column="1"
                                            Text="Claim Project"
                                            Clicked="OnClaimIdeaClicked"
                                            CommandParameter="{Binding .}"
                                            HeightRequest="34"
                                            FontSize="12"
                                            Padding="12,0"
                                            Style="{StaticResource PrimaryButtonStyle}" />

                                    <Label Grid.Row="1" Grid.ColumnSpan="2"
                                           Text="{Binding ProblemStatement}"
                                           FontSize="12"
                                           TextColor="#475569"
                                           MaxLines="2"
                                           Margin="0,6" />

                                    <Label Grid.Row="2" Grid.ColumnSpan="2"
                                           Text="{Binding TargetPersona, StringFormat='Target Audience: {0}'}"
                                           FontSize="11"
                                           TextColor="#64748B"
                                           FontAttributes="Italic" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Section: Claimed Projects -->
                <Label Text="🚀 Claimed Projects &amp; Status Pipelines" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextPrimaryColor}" Margin="0,10,0,0" />

                <CollectionView ItemsSource="{Binding ClaimedProjects}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:WishItem">
                            <Border Margin="0,4" Padding="12" Style="{StaticResource CardBorderStyle}">
                                <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="*, Auto">
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                        <Label Text="{Binding Title}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextPrimaryColor}" />
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="{Binding ClaimedByDeveloper, StringFormat='Dev: {0}'}" FontSize="11" TextColor="#2563EB" FontAttributes="Bold" />
                                            <Label Text="•" FontSize="11" TextColor="Gray" />
                                            <Label Text="{Binding TargetReleaseQuarter, StringFormat='Target: {0}'}" FontSize="11" TextColor="#D97706" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>

                                    <!-- Status Badge -->
                                    <Border Grid.Row="0" Grid.Column="1"
                                            BackgroundColor="{Binding LifecycleStatus, Converter={StaticResource StatusColorConverter}}"
                                            Padding="8,3"
                                            VerticalOptions="Start"
                                            StrokeShape="RoundRectangle 4">
                                        <Label Text="{Binding LifecycleStatus, Converter={StaticResource StatusDisplayNameConverter}}" 
                                               FontSize="10" 
                                               TextColor="White" 
                                               FontAttributes="Bold" />
                                    </Border>

                                    <Label Grid.Row="1" Grid.ColumnSpan="2"
                                           Text="{Binding ProblemStatement}"
                                           FontSize="12"
                                           TextColor="#475569"
                                           MaxLines="2"
                                           Margin="0,6" />

                                    <Button Grid.Row="2" Grid.ColumnSpan="2"
                                            Text="⚙️ Update Lifecycle Status"
                                            Clicked="OnUpdateStatusClicked"
                                            CommandParameter="{Binding .}"
                                            HeightRequest="32"
                                            FontSize="11"
                                            BackgroundColor="#F1F5F9"
                                            TextColor="{StaticResource TextPrimaryColor}"
                                            Margin="0,4,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
