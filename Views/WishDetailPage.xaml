<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Prototype_Final_Project.ViewModels"
             xmlns:models="clr-namespace:Prototype_Final_Project.Models"
             x:Class="Prototype_Final_Project.Views.WishDetailPage"
             x:DataType="viewmodels:WishDetailViewModel"
             Title="Wish Details"
             BackgroundColor="#F8FAFC">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="18">

            <!-- Title & Status Header Card -->
            <Border Padding="16" Style="{StaticResource CardBorderStyle}">
                <VerticalStackLayout Spacing="10">
                    <HorizontalStackLayout Spacing="8">
                        <Border BackgroundColor="{Binding Wish.LifecycleStatus, Converter={StaticResource StatusColorConverter}}"
                                Padding="8,4" StrokeShape="RoundRectangle 4">
                            <Label Text="{Binding Wish.LifecycleStatus, Converter={StaticResource StatusDisplayNameConverter}}" 
                                   FontSize="11" TextColor="White" FontAttributes="Bold" />
                        </Border>
                        <Border BackgroundColor="#EEF2FF" Padding="8,4" StrokeShape="RoundRectangle 4">
                            <Label Text="{Binding Wish.SubmissionType, Converter={StaticResource SubmissionTypeBadgeConverter}}" 
                                   FontSize="11" TextColor="#4338CA" FontAttributes="Bold" />
                        </Border>
                    </HorizontalStackLayout>

                    <Label Text="{Binding Wish.Title}" 
                           FontSize="20" 
                           FontAttributes="Bold" 
                           TextColor="{StaticResource TextPrimaryColor}" />

                    <!-- Upvote Action Row -->
                    <Grid ColumnDefinitions="*, Auto" Margin="0,6,0,0">
                        <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                            <Label Text="{Binding Wish.UpvoteCount, StringFormat='🔥 {0} Community Upvotes'}" 
                                   FontSize="14" FontAttributes="Bold" TextColor="#2563EB" VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <Button Grid.Column="1"
                                Text="▲ Upvote"
                                Command="{Binding UpvoteCommand}"
                                HeightRequest="38"
                                Padding="16,0"
                                CornerRadius="6"
                                BackgroundColor="#2563EB"
                                TextColor="White">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding Wish.HasUserUpvoted}" Value="True">
                                    <Setter Property="Text" Value="Upvoted 👍" />
                                    <Setter Property="BackgroundColor" Value="#16A34A" />
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Metadata Specifications Card -->
            <Border Padding="14" Style="{StaticResource CardBorderStyle}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="📋 Product Specifications" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimaryColor}" />
                    
                    <Grid ColumnDefinitions="140, *" RowDefinitions="Auto, Auto, Auto, Auto" RowSpacing="8">
                        <Label Grid.Row="0" Grid.Column="0" Text="Category:" TextColor="#64748B" FontSize="13" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding Wish.Category}" TextColor="{StaticResource TextPrimaryColor}" FontSize="13" FontAttributes="Bold" />

                        <Label Grid.Row="1" Grid.Column="0" Text="Target Platform:" TextColor="#64748B" FontSize="13" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding Wish.TargetPlatform}" TextColor="{StaticResource TextPrimaryColor}" FontSize="13" FontAttributes="Bold" />

                        <Label Grid.Row="2" Grid.Column="0" Text="Target Audience:" TextColor="#64748B" FontSize="13" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding Wish.TargetPersona}" TextColor="{StaticResource TextPrimaryColor}" FontSize="13" />

                        <Label Grid.Row="3" Grid.Column="0" Text="Submitted On:" TextColor="#64748B" FontSize="13" />
                        <Label Grid.Row="3" Grid.Column="1" Text="{Binding Wish.CreatedAt, StringFormat='{0:MMM dd, yyyy}'}" TextColor="{StaticResource TextPrimaryColor}" FontSize="13" />
                    </Grid>

                    <!-- Feature Request Specific: Existing App -->
                    <VerticalStackLayout IsVisible="{Binding IsFeatureRequest}" Spacing="4" Margin="0,6,0,0">
                        <Label Text="Associated Existing Application:" TextColor="#64748B" FontSize="12" />
                        <Border BackgroundColor="#FEF3C7" Padding="10,6" StrokeShape="RoundRectangle 6">
                            <Label Text="{Binding Wish.ExistingAppName}" FontSize="14" FontAttributes="Bold" TextColor="#92400E" />
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Problem Statement Card -->
            <Border Padding="14" Style="{StaticResource CardBorderStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="💡 Problem Statement &amp; Pain Point" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimaryColor}" />
                    <Label Text="{Binding Wish.ProblemStatement}" FontSize="14" TextColor="#334155" LineHeight="1.3" />
                </VerticalStackLayout>
            </Border>

            <!-- Developer Claim / Progress Card -->
            <Border Padding="14" Style="{StaticResource CardBorderStyle}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="🛠️ Developer Execution Status" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimaryColor}" />

                    <!-- If Claimed -->
                    <VerticalStackLayout IsVisible="{Binding IsClaimed}" Spacing="8">
                        <Grid ColumnDefinitions="140, *" RowDefinitions="Auto, Auto" RowSpacing="6">
                            <Label Grid.Row="0" Grid.Column="0" Text="Claimed By:" TextColor="#64748B" FontSize="13" />
                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding Wish.ClaimedByDeveloper}" TextColor="#2563EB" FontSize="13" FontAttributes="Bold" />

                            <Label Grid.Row="1" Grid.Column="0" Text="Release Target:" TextColor="#64748B" FontSize="13" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding Wish.TargetReleaseQuarter}" TextColor="#D97706" FontSize="13" FontAttributes="Bold" />
                        </Grid>

                        <Button IsVisible="{Binding HasExternalUrl}"
                                Text="🔗 View Project Repository / Site"
                                Command="{Binding OpenExternalLinkCommand}"
                                HeightRequest="38"
                                BackgroundColor="#F1F5F9"
                                TextColor="{StaticResource TextPrimaryColor}"
                                Margin="0,4,0,0" />
                    </VerticalStackLayout>

                    <!-- If Unclaimed -->
                    <VerticalStackLayout IsVisible="{Binding IsClaimed, Converter={StaticResource InverseBoolConverter}}" Spacing="8">
                        <Label Text="This validated concept has not yet been claimed by a developer. Be the first to build and bring it to market!"
                               FontSize="12" TextColor="#64748B" />
                        
                        <Button Text="Claim this Concept as Developer"
                                Command="{Binding ClaimProjectCommand}"
                                HeightRequest="42"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Community Discussion & Comments Thread Card (Section 3 & 4) -->
            <Border Padding="14" Style="{StaticResource CardBorderStyle}">
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="💬 Community Discussion &amp; Feedback" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextPrimaryColor}" />
                        <Border BackgroundColor="#EEF2FF" Padding="6,2" StrokeShape="RoundRectangle 4">
                            <Label Text="{Binding Comments.Count, StringFormat='{0} comments'}" FontSize="11" TextColor="#4338CA" FontAttributes="Bold" />
                        </Border>
                    </HorizontalStackLayout>

                    <!-- Comments List -->
                    <CollectionView ItemsSource="{Binding Comments}" SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Label Text="No comments posted yet. Start the conversation below!" 
                                   FontSize="12" TextColor="#94A3B8" FontAttributes="Italic" Margin="0,4" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:CommentItem">
                                <Border Margin="0,4" Padding="10" BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeShape="RoundRectangle 6">
                                    <VerticalStackLayout Spacing="4">
                                        <HorizontalStackLayout Spacing="8">
                                            <Label Text="{Binding AuthorName}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPrimaryColor}" />
                                            <Border BackgroundColor="#E0E7FF" Padding="4,1" StrokeShape="RoundRectangle 3">
                                                <Label Text="{Binding AuthorRole}" FontSize="9" TextColor="#3730A3" FontAttributes="Bold" />
                                            </Border>
                                            <Label Text="{Binding CreatedAt, StringFormat='{0:MMM dd}'}" FontSize="11" TextColor="#94A3B8" />
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding Content}" FontSize="13" TextColor="#334155" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Add Comment Form -->
                    <Border BackgroundColor="#F1F5F9" Padding="12" StrokeShape="RoundRectangle 6" Margin="0,6,0,0">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="✍️ Add Your Feedback or Question" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextPrimaryColor}" />
                            
                            <Grid ColumnDefinitions="*, 120" ColumnSpacing="8">
                                <Entry Grid.Column="0" 
                                       Placeholder="Your name (e.g. Alex, Student)" 
                                       Text="{Binding NewCommentAuthor}" 
                                       BackgroundColor="White" 
                                       FontSize="12" 
                                       HeightRequest="36" />
                                
                                <Picker Grid.Column="1" 
                                        SelectedItem="{Binding NewCommentRole}" 
                                        BackgroundColor="White" 
                                        FontSize="12" 
                                        HeightRequest="36">
                                    <Picker.ItemsSource>
                                        <x:Array Type="{x:Type x:String}">
                                            <x:String>Community</x:String>
                                            <x:String>Wisher</x:String>
                                            <x:String>Developer</x:String>
                                        </x:Array>
                                    </Picker.ItemsSource>
                                </Picker>
                            </Grid>

                            <Editor Placeholder="Ask the wisher a question, suggest an API, or give technical feedback..." 
                                    Text="{Binding NewCommentText}" 
                                    BackgroundColor="White" 
                                    HeightRequest="70" 
                                    FontSize="12" />

                            <Button Text="Post Comment" 
                                    Command="{Binding AddCommentCommand}" 
                                    HeightRequest="36" 
                                    FontSize="12" 
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
